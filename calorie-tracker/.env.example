# Runtime mode: development or production
APP_ENV=development

# OpenAI models for meal analysis and coaching
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
COACH_MODEL=gpt-4o-mini

# Withings public API integration for smart scales
WITHINGS_CLIENT_ID=your_withings_client_id_here
WITHINGS_CLIENT_SECRET=your_withings_client_secret_here
WITHINGS_REDIRECT_URI=http://localhost:8000/withings/callback
APP_FRONTEND_URL=http://localhost:8080/profile.html

# Authentication. The app refuses the default secret in production.
JWT_SECRET=replace_with_at_least_32_random_characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Trusted browser origins. Do not use * in production.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Request, image and private-media protection
MAX_REQUEST_BODY_BYTES=5242880
MAX_IMAGE_BYTES=4194304
MAX_IMAGE_PIXELS=25000000
MAX_IMAGE_DIMENSION=1600
MEDIA_URL_TTL_SECONDS=1800
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
ANALYSIS_RATE_LIMIT_REQUESTS=30
ANALYSIS_RATE_LIMIT_WINDOW_SECONDS=3600

DATABASE_URL=sqlite:////app/data/app.db

LOG_LEVEL=INFO
LOG_DIR=backend/logs
LOG_FILE_MAX_SIZE=10485760
LOG_FILE_BACKUP_COUNT=5
LOG_ACCESS_TO_CONSOLE=False
