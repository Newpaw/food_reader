# Runtime mode: development or production
APP_ENV=development

# OpenAI API key for AI food analysis
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Withings public API integration for smart scales
# Configure the same redirect URI in your Withings developer application.
WITHINGS_CLIENT_ID=your_withings_client_id_here
WITHINGS_CLIENT_SECRET=your_withings_client_secret_here
WITHINGS_REDIRECT_URI=http://localhost:8000/withings/callback
APP_FRONTEND_URL=http://localhost:8080/profile.html

# Secret key for JWT token generation
# Generate a strong random string for production use.
# The app refuses to start in production when the default secret is used.
JWT_SECRET=your_jwt_secret_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated trusted browser origins. Do not use * in production.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Request protection
MAX_REQUEST_BODY_BYTES=5242880
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
ANALYSIS_RATE_LIMIT_REQUESTS=30
ANALYSIS_RATE_LIMIT_WINDOW_SECONDS=3600

# Database connection URL
DATABASE_URL=sqlite:////app/data/app.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S
LOG_ROTATION_SIZE=10485760
LOG_BACKUP_COUNT=5
LOG_TO_CONSOLE=True
LOG_TO_FILE=True
REQUEST_LOGGING_ENABLED=True
