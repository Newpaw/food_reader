# Runtime ports on the VM
BACKEND_PORT=18000
FRONTEND_PORT=18080

# Application database - keep this path unchanged with deploy/docker-compose.prod.yml
DATABASE_URL=sqlite:////app/data/app.db

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Public MCP + OAuth origin. Must be HTTPS and resolve to this deployment.
MCP_PUBLIC_BASE_URL=https://food.example.com
MCP_ACCESS_TOKEN_EXPIRE_MINUTES=60
MCP_REFRESH_TOKEN_EXPIRE_DAYS=30

# OpenAI
OPENAI_API_KEY=replace-me

# Default model for all AI workloads. GPT-5.6 Terra is the balanced production default.
LLM_MODEL=gpt-5.6-terra

# Optional per-workload overrides. Leave blank to inherit LLM_MODEL.
MEAL_ANALYSIS_MODEL=
HEALTH_COACH_MODEL=
ASSISTANT_MODEL=

# Withings OAuth
WITHINGS_CLIENT_ID=replace-me
WITHINGS_CLIENT_SECRET=replace-me
WITHINGS_REDIRECT_URI=https://food.example.com/withings/callback
APP_FRONTEND_URL=https://food.example.com/profile.html

# Oura OAuth
OURA_CLIENT_ID=replace-me
OURA_CLIENT_SECRET=replace-me
OURA_REDIRECT_URI=https://food.example.com/oura/callback
OURA_FRONTEND_URL=https://food.example.com/health.html

# Oura webhooks. With MCP_PUBLIC_BASE_URL set to the same public origin, the
# callback defaults to https://food.example.com/oura/webhook. The verification
# token can be left blank; Food Reader derives a stable value from JWT_SECRET.
OURA_WEBHOOK_ENABLED=true
OURA_WEBHOOK_CALLBACK_URL=
OURA_WEBHOOK_VERIFICATION_TOKEN=
OURA_WEBHOOK_DATA_TYPES=daily_activity,daily_readiness,daily_sleep,sleep,daily_stress,workout,daily_spo2,daily_resilience,daily_cardiovascular_age,vo2_max,sleep_time,rest_mode_period,session,enhanced_tag,ring_configuration
OURA_WEBHOOK_EVENT_TYPES=create,update
OURA_WEBHOOK_RENEW_DAYS=7
OURA_WEBHOOK_RECONCILE_HOURS=12
OURA_WEBHOOK_STARTUP_DELAY_SECONDS=8

# Logging
LOG_LEVEL=INFO
LOG_TO_CONSOLE=True
LOG_TO_FILE=False
REQUEST_LOGGING_ENABLED=True
